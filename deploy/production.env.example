# Review docs/deployment-readiness.md before using. All blanks intentionally fail closed.
# This file is a template, not a credential or policy approval.
COMGROUND_ORIGIN=
COMGROUND_OUTBOX_KEY=
COMGROUND_ADULT_POLICY_ACK=
# Backup operations require a different persistent 32-byte base64 key.
COMGROUND_BACKUP_KEY=
# Provider adapters stay disabled until separately approved and configured.
COMGROUND_EMAIL_ENABLED=0
COMGROUND_EMAIL_FROM=
RESEND_API_KEY=
# Optional separate Resend/Svix signing secret; blank rejects receipt processing.
# Configure only after approving the canonical HTTPS webhook endpoint and event selection.
COMGROUND_RESEND_WEBHOOK_SECRET=
COMGROUND_AI_ENABLED=0
COMGROUND_AI_MODEL=
COMGROUND_AI_POLICY_ACK=
OPENAI_API_KEY=
